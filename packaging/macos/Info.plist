<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.yangharry.printerhelper</string>
	<key>CFBundleExecutable</key>
	<string>PrinterHelper</string>
	<!-- The bundle's file name. Finder shows the localized name from ko.lproj/InfoPlist.strings only when the base
	     CFBundleDisplayName matches the file name (PrinterHelper.app). -->
	<key>CFBundleName</key>
	<string>PrinterHelper</string>
	<key>CFBundleDisplayName</key>
	<string>PrinterHelper</string>
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>CFBundleIconFile</key>
	<string>PrinterHelper</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (c) 2026 yangharry</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- The window is drawn in light colors only; keep the title bar and system dialogs light as well. -->
	<key>NSRequiresAquaSystemAppearance</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 네트워크의 복합기를 찾아 스캔하고 상태를 읽습니다.</string>
